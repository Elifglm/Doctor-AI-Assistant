# --- Database ---
# SQLite (varsayilan, tek makine):
#   bos birak veya yorumla
# MariaDB (ekip paylasimi, Docker uzerinden):
#   asagidaki satiri ac
DATABASE_URL=mysql+asyncmy://klinik:klinik@127.0.0.1:3307/klinikasistan

# --- LLM ---
ASR_LLM__MODE=anthropic
ASR_LLM__ANTHROPIC_API_KEY=

# --- ASR ---
HF_TOKEN=

# --- Embedding profile (minilm | e5-large) ---
EMBEDDING_MODEL=minilm

# --- SUT tetkik intent disambiguation ---
# v1 = legacy prompt, v2 = per-mention CoT (default)
ASR_SUT__INTENT_PROMPT_VERSION=v2
# REQUEST altinda confidence buysa NOT_REQUEST'e indir (false-positive guvenligi)
ASR_SUT__INTENT_MIN_CONFIDENCE=0.70

# --- OpenEMR ---
# OpenEMR ayarlari ayri dosyada: .env.openemr
# Kurulum: cp .env.openemr.example .env.openemr  (sonra duzenle)
