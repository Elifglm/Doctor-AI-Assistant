# =============================================================================
# OpenEMR Bağlantı Konfigürasyonu — ÖRNEK
# =============================================================================
# Kullanım:
#   1. Bu dosyayı `.env.openemr` olarak kopyala
#   2. Aşağıdaki değerleri kendi kurulumuna göre doldur
#   3. OpenEMR Admin > API Clients'tan kayıt yapıp client_id/secret'ı buraya yaz
#
# .env.openemr `.gitignore`'da — secret'lar repo'ya gitmez.
# -----------------------------------------------------------------------------

# --- OAuth2 ---
# OpenEMR 7.x manual client registration gerektirir:
#   1. http://localhost:8300 → admin/pass ile login
#   2. Administration → System → API Clients → "Register New App"
#   3. application_type=private, scope: "openid api:oemr offline_access"
#   4. Verilen client_id + client_secret'ı buraya yapıştır
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=

# --- Hangi kurulumu kullanıyorsun? Birini seç, diğerlerini yorumda bırak ---

# (A) Docker compose stack — backend container'ı (compose network içinde)
#OPENEMR_BASE_URL=http://openemr/apis/default
#OPENEMR_USERNAME=admin
#OPENEMR_PASSWORD=pass
#OPENEMR_MYSQL_HOST=mysql
#OPENEMR_MYSQL_PORT=3306
#OPENEMR_MYSQL_USER=openemr
#OPENEMR_MYSQL_PASSWORD=openemr
#OPENEMR_MYSQL_DB=openemr

# (B) Docker compose stack — backend HOST'ta uvicorn ile (port mapping üzerinden)
#OPENEMR_BASE_URL=http://localhost:8300/apis/default
#OPENEMR_USERNAME=admin
#OPENEMR_PASSWORD=pass
#OPENEMR_MYSQL_HOST=127.0.0.1
#OPENEMR_MYSQL_PORT=3307
#OPENEMR_MYSQL_USER=openemr
#OPENEMR_MYSQL_PASSWORD=openemr
#OPENEMR_MYSQL_DB=openemr

# (C) Native kurulum — XAMPP + OpenEMR (Docker'sız)
OPENEMR_BASE_URL=http://localhost/openemr/apis/default
OPENEMR_USERNAME=administrator
OPENEMR_PASSWORD=administrator
OPENEMR_MYSQL_HOST=127.0.0.1
OPENEMR_MYSQL_PORT=3306
OPENEMR_MYSQL_USER=openemr
OPENEMR_MYSQL_PASSWORD=openemr
OPENEMR_MYSQL_DB=openemr
