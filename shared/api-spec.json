{
  "openapi": "3.1.0",
  "info": {
    "title": "Doctor AI Assistant API",
    "version": "1.0.0",
    "description": "Backend API for medical documentation assistant"
  },
  "servers": [
    { "url": "http://127.0.0.1:8700", "description": "Local dev" }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["health"],
        "summary": "Health check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Login with credentials",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "summary": "Refresh JWT token",
        "operationId": "refreshToken",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Logout (invalidate token)",
        "operationId": "logout",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/sessions": {
      "get": {
        "tags": ["sessions"],
        "summary": "List sessions with optional filters",
        "operationId": "listSessions",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "from_date", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "to_date", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "default": "created_at:desc" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionListResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["sessions"],
        "summary": "Create new session",
        "operationId": "createSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSessionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}": {
      "get": {
        "tags": ["sessions"],
        "summary": "Get session detail with segments and reports",
        "operationId": "getSession",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionDetailResponse" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["sessions"],
        "summary": "Update session",
        "operationId": "updateSession",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateSessionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["sessions"],
        "summary": "Archive session (soft delete)",
        "operationId": "archiveSession",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Archived" } }
      }
    },
    "/api/v1/sessions/{id}/transcription": {
      "get": {
        "tags": ["transcription"],
        "summary": "Get transcription segments for session",
        "operationId": "getTranscription",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TranscriptionResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/transcription/ws/{session_id}": {
      "description": "WebSocket endpoint for audio streaming and transcription",
      "x-websocket": {
        "messages": {
          "client_to_server": [
            { "type": "binary", "description": "Audio chunk (webm/opus, 250ms)" },
            { "type": "json", "schema": { "type": "object", "properties": { "type": { "const": "stop" } } } }
          ],
          "server_to_client": [
            {
              "type": "json",
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/WSProgress" },
                  { "$ref": "#/components/schemas/WSResult" },
                  { "$ref": "#/components/schemas/WSError" }
                ]
              }
            }
          ]
        }
      }
    },
    "/api/v1/reports": {
      "post": {
        "tags": ["reports"],
        "summary": "Generate report for session (empty template or AI-generated)",
        "operationId": "generateReport",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GenerateReportRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/{id}": {
      "get": {
        "tags": ["reports"],
        "summary": "Get report detail",
        "operationId": "getReport",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportResponse" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["reports"],
        "summary": "Update report (edit sections, approve)",
        "operationId": "updateReport",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateReportRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/{id}/versions": {
      "get": {
        "tags": ["reports"],
        "summary": "Get report version history",
        "operationId": "getReportVersions",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ReportResponse" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded", "error"] },
          "gpu_available": { "type": "boolean" },
          "gpu_name": { "type": "string" },
          "gpu_memory_used_mb": { "type": "number" },
          "gpu_memory_total_mb": { "type": "number" },
          "db_connected": { "type": "boolean" },
          "asr_pipeline_ready": { "type": "boolean" },
          "version": { "type": "string" }
        },
        "required": ["status", "gpu_available", "db_connected", "asr_pipeline_ready"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" }
        },
        "required": ["username", "password"]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string", "default": "bearer" },
          "expires_in": { "type": "integer" },
          "user": { "$ref": "#/components/schemas/UserInfo" }
        },
        "required": ["access_token", "token_type"]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "default": 0 },
          "username": { "type": "string" },
          "display_name": { "type": "string" },
          "role": { "type": "string" },
          "brans": { "type": "string", "default": "" }
        },
        "required": ["username", "display_name", "role"]
      },
      "CreateSessionRequest": {
        "type": "object",
        "properties": {
          "patient_id": { "type": "string", "default": "" },
          "patient_name": { "type": "string", "default": "" },
          "doctor_name": { "type": "string" },
          "visit_type": { "type": "string", "enum": ["ilk_muayene", "kontrol", "konsultasyon", "acil"], "default": "ilk_muayene" },
          "pre_diagnosis": { "type": "string", "default": "" },
          "location": { "type": "string", "default": "" },
          "kvkk_consent": { "type": "boolean" }
        },
        "required": ["doctor_name", "kvkk_consent"]
      },
      "UpdateSessionRequest": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["NOT_STARTED", "RECORDING", "PROCESSING", "AWAITING_REVIEW", "COMPLETED", "ARCHIVED"] },
          "patient_id": { "type": "string" },
          "patient_name": { "type": "string" },
          "pre_diagnosis": { "type": "string" },
          "location": { "type": "string" },
          "audio_file_path": { "type": "string" },
          "audio_duration_seconds": { "type": "number" }
        }
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "patient_id": { "type": "string" },
          "patient_name": { "type": "string" },
          "doctor_name": { "type": "string" },
          "visit_type": { "type": "string" },
          "status": { "type": "string" },
          "pre_diagnosis": { "type": "string" },
          "location": { "type": "string" },
          "audio_file_path": { "type": "string" },
          "kvkk_consent": { "type": "boolean" },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time" },
          "audio_duration_seconds": { "type": "number" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "doctor_name", "visit_type", "status", "created_at"]
      },
      "SessionListResponse": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/SessionResponse" } },
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "pages": { "type": "integer" }
        },
        "required": ["items", "total", "page", "limit", "pages"]
      },
      "SessionDetailResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SessionResponse" },
          {
            "type": "object",
            "properties": {
              "segments": { "type": "array", "items": { "$ref": "#/components/schemas/TranscriptionSegment" } },
              "reports": { "type": "array", "items": { "$ref": "#/components/schemas/ReportResponse" } }
            }
          }
        ]
      },
      "TranscriptionSegment": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "session_id": { "type": "integer" },
          "segment_index": { "type": "integer" },
          "text": { "type": "string" },
          "speaker": { "type": "string" },
          "speaker_label": { "type": "string" },
          "start_time": { "type": "number" },
          "end_time": { "type": "number" },
          "confidence": { "type": "number" },
          "words": { "type": "array", "items": { "type": "object" } },
          "is_edited": { "type": "boolean" }
        },
        "required": ["id", "session_id", "segment_index", "text", "speaker", "speaker_label", "start_time", "end_time"]
      },
      "TranscriptionResponse": {
        "type": "object",
        "properties": {
          "session_id": { "type": "integer" },
          "segments": { "type": "array", "items": { "$ref": "#/components/schemas/TranscriptionSegment" } },
          "full_text": { "type": "string" },
          "duration_seconds": { "type": "number" },
          "num_speakers": { "type": "integer" }
        },
        "required": ["session_id", "segments"]
      },
      "ReportSection": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "approved", "edited"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        },
        "required": ["key", "title", "content", "status"]
      },
      "ReportContent": {
        "type": "object",
        "properties": {
          "sections": { "type": "array", "items": { "$ref": "#/components/schemas/ReportSection" } },
          "approved_sections": { "type": "integer" },
          "total_sections": { "type": "integer" }
        },
        "required": ["sections", "approved_sections", "total_sections"]
      },
      "GenerateReportRequest": {
        "type": "object",
        "properties": {
          "session_id": { "type": "integer" },
          "method": { "type": "string", "enum": ["manual", "ai_generated"], "default": "manual" }
        },
        "required": ["session_id"]
      },
      "UpdateReportRequest": {
        "type": "object",
        "properties": {
          "content": { "$ref": "#/components/schemas/ReportContent" },
          "status": { "type": "string", "enum": ["DRAFT", "REVIEWED", "APPROVED", "FINALIZED"] }
        }
      },
      "ReportResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "session_id": { "type": "integer" },
          "version": { "type": "integer" },
          "status": { "type": "string" },
          "content": { "$ref": "#/components/schemas/ReportContent" },
          "generation_method": { "type": "string" },
          "approved_at": { "type": "string", "format": "date-time" },
          "approved_by": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "session_id", "version", "status", "content", "created_at"]
      },
      "WSProgress": {
        "type": "object",
        "properties": {
          "type": { "const": "progress" },
          "stage": { "type": "string" },
          "message": { "type": "string" },
          "progress": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["type", "stage", "message"]
      },
      "WSResult": {
        "type": "object",
        "properties": {
          "type": { "const": "result" },
          "session_id": { "type": "integer" },
          "segments": { "type": "array", "items": { "$ref": "#/components/schemas/TranscriptionSegment" } },
          "full_text": { "type": "string" },
          "metadata": { "type": "object" }
        },
        "required": ["type", "session_id", "segments"]
      },
      "WSError": {
        "type": "object",
        "properties": {
          "type": { "const": "error" },
          "message": { "type": "string" },
          "code": { "type": "string" }
        },
        "required": ["type", "message"]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [{ "bearerAuth": [] }]
}
